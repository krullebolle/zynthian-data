@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufs:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix plug:  <urn:org.surge-synth-team.OB-Xf-rework:> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#master group
plug:Volume
	a lv2:Parameter ;
	rdfs:label "Volume" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:Transpose
	a lv2:Parameter ;
	rdfs:label "Transpose" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -24 ;
	lv2:maximum 24 ;
    rdfs:comment "Transpose overall sound per note" .

plug:Tune
	a lv2:Parameter ;
	rdfs:label "Tune" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -100 ;
	lv2:maximum 100 ;
    rdfs:comment "Fine tuning the overall pitch in cents" .

#Global group
plug:Polyphony
	a lv2:Parameter ;
	rdfs:label "Polyphony" ;
	rdfs:range atom:Float ;
	lv2:default 8 ;
	lv2:minimum 1 ;
	lv2:maximum 32 .

plug:HQMode
	a lv2:Parameter ;
	rdfs:label "High Quality Mode" ;
	rdfs:range atom:Float ;
	rdfs:comment "THigh Quality mode at the expense of CPU consumption." ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:UnisonVoices
	a lv2:Parameter ;
	rdfs:label "Unison Voices" ;
	rdfs:range atom:Float ;
	lv2:default 8 ;
	lv2:minimum 1 ;
	lv2:maximum 32 .

plug:Portamento
	a lv2:Parameter ;
	rdfs:label "Portamento" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1.0 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ] .

plug:Unison
	a lv2:Parameter ;
	rdfs:label "Unison" ;
	rdfs:range atom:Float ;
	rdfs:comment "Single-note mode that stacks all the voices available. Spread and Voice Panning are assets in this mode" ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:UnisonDetune
	a lv2:Parameter ;
	rdfs:label "Unison Detune" ;
	rdfs:range atom:Float ;
	rdfs:comment "This detunes the oscillators relative to each other to thicken the sound and add stereo width." ;
	lv2:default 0.25 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:EnvLegatoMode
	a lv2:Parameter ;
	rdfs:label "Envelope Legato Mode" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 3 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "Keep All" ;
            rdfs:comment "Keep All" ;
        ], [
            rdf:value 1 ;
            rdfs:label "Filtr Env" ;
            rdfs:comment "Filter Envelope" ;
        ], [
            rdf:value 2 ;
            rdfs:label "Amp Env" ;
            rdfs:comment "Amplifier Envelope" ;
        ], [
            rdf:value 3 ;
            rdfs:label "Retrig" ;
            rdfs:comment "Retrigger" ;
        ] .

plug:NotePriority
	a lv2:Parameter ;
	rdfs:label "Note Priority" ;
	rdfs:range atom:Float ;
	rdfs:comment "Switches the priority of voice allocation from the default lowest-note priority to last-played-note." ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

# Oscillator group
plug:Osc1Pitch
	a lv2:Parameter ;
	rdfs:label "Osc 1 Pitch" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -24 ;
	lv2:maximum 24 .

plug:Osc2Detune
	a lv2:Parameter ;
	rdfs:label "Osc 2 Detune" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:Osc2Pitch
	a lv2:Parameter ;
	rdfs:label "Osc 2 Pitch" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -24 ;
	lv2:maximum 24 .

plug:Osc1SawWave
	a lv2:Parameter ;
	rdfs:label "Osc 1 Saw Wave" ;
	rdfs:range atom:Float ;
    rdfs:comment "Sawtooth wave button. A ramped pulse-wave is achieved by selecting both sawtooth and pulse options. When neither sawtooth or pulse is selected, the OSC produces a triangle wave." ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:Osc1PulseWave
	a lv2:Parameter ;
	rdfs:label "Osc 1 Pulse Wave" ;
	rdfs:range atom:Float ;
    rdfs:comment "Pulse Wave button (with adjustable pulse width - PW). A ramped pulse-wave is achieved by selecting both sawtooth and pulse options combined.  When neither sawtooth or pulse is selected, the OSC produces a triangle wave." ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:Osc2SawWave
	a lv2:Parameter ;
	rdfs:label "Osc 2 Saw Wave" ;
	rdfs:range atom:Float ;
    rdfs:comment "Sawtooth wave button. A ramped pulse-wave is achieved by selecting both sawtooth and pulse options combined. When neither sawtooth or pulse is selected, the OSC produces a triangle wave." ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:Osc2PulseWave
	a lv2:Parameter ;
	rdfs:label "Osc 2 Pulse Wave" ;
	rdfs:range atom:Float ;
    rdfs:comment "Pulse Wave button (with adjustable pulse width - PW). A ramped pulse-wave is achieved by selecting both sawtooth and pulse options combined.  When neither sawtooth or pulse is selected, the OSC produces a triangle wave." ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:OscPW
	a lv2:Parameter ;
	rdfs:label "Osc Pulsewidth" ;
	rdfs:range atom:Float ;
    rdfs:comment "Adjusts the pulse width of the selected pulse wave oscillators (OSC1 and or OSC2)" ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:Osc2PWOffset
	a lv2:Parameter ;
	rdfs:label "Osc 2 PW Offset" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:EnvToPitchAmount
	a lv2:Parameter ;
	rdfs:label "Filter Env to Pitch" ;
	rdfs:range atom:Float ;
    rdfs:comment "The amount of pitch detuning from OSC2 controlled by the filter envelope. " ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 36 .

plug:EnvToPitchBothOscs
	a lv2:Parameter ;
	rdfs:label "Filter Env to Both Osc Pitch" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:EnvToPitchInvert
	a lv2:Parameter ;
	rdfs:label "Invert Filter Env to Pitch" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:EnvToPWAmount
	a lv2:Parameter ;
	rdfs:label "Filter Env to PW" ;
	rdfs:range atom:Float ;
    rdfs:comment "The amount of pulse width from OSC2 controlled by the filter envelope. " ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:EnvToPWBothOscs
	a lv2:Parameter ;
	rdfs:label "Filter Env to Both Osc PW" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:EnvToPWInvert
	a lv2:Parameter ;
	rdfs:label "Invert Filter Env to PW" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:OscCrossmod
	a lv2:Parameter ;
	rdfs:label "Cross Modulation" ;
	rdfs:range atom:Float ;
    rdfs:comment "cross modulation, with Oscillator 1 modulating Oscillator 2 (Frequency Modulation)" ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:OscSync
	a lv2:Parameter ;
	rdfs:label "Osc Sync" ;
	rdfs:range atom:Float ;
    rdfs:comment "Synchronises the +/- oscillations of both OSC1 and OSC2 resulting in a narrower, more precise tone" ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:OscBrightness
	a lv2:Parameter ;
	rdfs:label "Osc Brightness" ;
	rdfs:range atom:Float ;
    rdfs:comment "adjusts the clarity of higher harmonics" ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

#Mixer group
plug:Osc1Mix
	a lv2:Parameter ;
	rdfs:label "Osc 1 Volume" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:Osc2Mix
	a lv2:Parameter ;
	rdfs:label "Osc 2 Volume" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:RingModMix
	a lv2:Parameter ;
	rdfs:label "Ring Mod Volume" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:NoiseMix
	a lv2:Parameter ;
	rdfs:label "Noise Volume" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:NoiseColor
	a lv2:Parameter ;
	rdfs:label "Noise Color" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "WHITE" ;
            rdfs:comment "White noise" ;
        ], [
            rdf:value 1 ;
            rdfs:label "PINK" ;
            rdfs:comment "Pink noise" ;
		], [
            rdf:value 2 ;
            rdfs:label "BROWN" ;
            rdfs:comment "Brown noise" ;
        ].


# control group
plug:PitchBendUp
	a lv2:Parameter ;
	rdfs:label "Pitch Bend Up" ;
	rdfs:range atom:Float ;
	lv2:default 2 ;
	lv2:minimum 0 ;
	lv2:maximum 48 ;
	rdfs:comment "Pitchbend upwards up to 4 octaves" .

plug:PitchBendDown
	a lv2:Parameter ;
	rdfs:label "Pitch Bend Down" ;
	rdfs:range atom:Float ;
	lv2:default 2 ;
	lv2:minimum 0 ;
	lv2:maximum 48 ;
	rdfs:comment "Pitchbend downwards up to 4 octaves" .

plug:BendOsc2Only
	a lv2:Parameter ;
	rdfs:label "Pitch Bend Osc 2 Only" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:VibratoWave
	a lv2:Parameter ;
	rdfs:label "Vibrato Wave" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "SINE" ;
            rdfs:comment "SINE" ;
        ], [
            rdf:value 1 ;
            rdfs:label "SQUARE" ;
            rdfs:comment "SQUARE" ;
        ].

plug:VibratoRate
	a lv2:Parameter ;
	rdfs:label "Vibrato Rate" ;
	rdfs:range atom:Float ;
	lv2:default 0.3 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

#filtergroup
plug:Filter4PoleMode
	a lv2:Parameter ;
	rdfs:label "Filter 4-Pole Mode" ;
	rdfs:range atom:Float ;
    rdfs:comment "This mode is only low-pass, but the MODE control now allows you to smoothly change the depth of the filter slope from 24dB/octave on the complete left, down to 6 dB/octave on the complete right." ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:FilterCutoff
	a lv2:Parameter ;
	rdfs:label "Filter Cutoff" ;
	rdfs:range atom:Float ;
	lv2:default 75 ;
	lv2:minimum -45 ;
	lv2:maximum 75 .

plug:FilterResonance
	a lv2:Parameter ;
	rdfs:label "Filter Resonance" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:FilterEnvAmount
	a lv2:Parameter ;
	rdfs:label "Filter Env Amount" ;
	rdfs:range atom:Float ;
    rdfs:comment "The amount of opening/closing of the filter (ADSR filter envelope) " ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:FilterKeyFollow
	a lv2:Parameter ;
	rdfs:label "Filter Keytrack" ;
	rdfs:range atom:Float ;
    rdfs:comment "Key-follow or keyboard-tracking, i.e. the filter is less intrusive on higher pitches" ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:FilterMode
	a lv2:Parameter ;
	rdfs:label "Filter Mode" ;
	rdfs:range atom:Float ;
    rdfs:comment "Allows you to morph the filter shape (as opposed to switch) between LPF (far left), Notch (centered) (default setting), and HPF (far right)" ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:Filter2PoleBPBlend
	a lv2:Parameter ;
	rdfs:label "Filter 2-Pole BP Blend" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:Filter2PolePush
	a lv2:Parameter ;
	rdfs:label "Filter 2-Pole Push" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:Filter4PoleXpander
	a lv2:Parameter ;
	rdfs:label "Filter 4-Pole Xpander" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "OFF" ;
            rdfs:comment "OFF" ;
        ], [
            rdf:value 1 ;
            rdfs:label "ON" ;
            rdfs:comment "ON" ;
        ].

plug:FilterXpanderMode
	a lv2:Parameter ;
	rdfs:label "Filter Xpander Mode" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 14 ;
	lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "LP4" ;
            rdfs:comment "LP4" ;
        ], [
            rdf:value 1 ;
            rdfs:label "LP3" ;
            rdfs:comment "LP3" ;
        ], [
		 	rdf:value 2 ;
            rdfs:label "LP2" ;
            rdfs:comment "LP2" ;
        ], [
            rdf:value 3 ;
            rdfs:label "LP1" ;
            rdfs:comment "LP1" ;
        ], [
		   rdf:value 4 ;
            rdfs:label "HP3" ;
            rdfs:comment "HP3" ;
        ], [
            rdf:value 5 ;
            rdfs:label "HP2" ;
            rdfs:comment "HP2" ;
        ], [
		 	rdf:value 6 ;
            rdfs:label "HP1" ;
            rdfs:comment "HP1" ;
        ], [
            rdf:value 7 ;
            rdfs:label "BP4" ;
            rdfs:comment "BP4" ;
        ], [
		   rdf:value 8 ;
            rdfs:label "BP2" ;
            rdfs:comment "BP2" ;
        ], [
            rdf:value 9 ;
            rdfs:label "N2" ;
            rdfs:comment "N2" ;
        ], [
		 	rdf:value 10 ;
            rdfs:label "PH3" ;
            rdfs:comment "PH3" ;
        ], [
            rdf:value 11 ;
            rdfs:label "HP2+LP1" ;
            rdfs:comment "HP2+LP1" ;
        ], [
			rdf:value 12 ;
            rdfs:label "HP3+LP1" ;
            rdfs:comment "HP3+LP1" ;
        ], [
            rdf:value 13 ;
            rdfs:label "N2+LP1" ;
            rdfs:comment "N2+LP1" ;
        ], [
			rdf:value 14 ;
            rdfs:label "PH3+LP1" ;
            rdfs:comment "PH3+LP1" ;
        ].

#LFO group
plug:LFO1TempoSync
	a lv2:Parameter ;
	rdfs:label "LFO 1 Tempo Sync" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:LFO1Rate
	a lv2:Parameter ;
	rdfs:label "LFO 1 Rate" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:LFO1ModAmount1
	a lv2:Parameter ;
	rdfs:label "LFO 1 Mod 1 Amount" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:LFO1ModAmount2
	a lv2:Parameter ;
	rdfs:label "LFO 1 Mod 2 Amount" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:LFO1Wave1
	a lv2:Parameter ;
	rdfs:label "LFO 1 Wave 1" ;
	rdfs:range atom:Float ;
	lv2:default -1 ;
	lv2:minimum -1 ;
	lv2:maximum 1 .

plug:LFO1Wave2
	a lv2:Parameter ;
	rdfs:label "LFO 1 Wave 2" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -1 ;
	lv2:maximum 1 .

plug:LFO1Wave3
	a lv2:Parameter ;
	rdfs:label "LFO 1 Wave 3" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -1 ;
	lv2:maximum 1 .

plug:LFO1PW
	a lv2:Parameter ;
	rdfs:label "LFO 1 Pulsewidth" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:LFO1ToOsc1Pitch
	a lv2:Parameter ;
	rdfs:label "LFO 1 to Osc 1 Pitch" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2 .

plug:LFO1ToOsc2Pitch
	a lv2:Parameter ;
	rdfs:label "LFO 1 to Osc 2 Pitch" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2 .

plug:LFO1ToFilterCutoff
	a lv2:Parameter ;
	rdfs:label "LFO 1 to Filter Cutoff" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2 .

plug:LFO1ToOsc1PW
	a lv2:Parameter ;
	rdfs:label "LFO 1 to Osc 1 PW" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2 .

plug:LFO1ToOsc2PW
	a lv2:Parameter ;
	rdfs:label "LFO 1 to Osc 2 PW" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
